// Prisma schema for "What Did I Miss" — Smart Market Watchlist
//
// Multi-user, but deliberately NOT multi-tenant-with-auth: there is no
// login, password, session, or OAuth anywhere in this app. `User` exists
// purely to demonstrate isolated per-user state (a watchlist, a set of
// checkpoints) via a plain, unauthenticated context switch in the UI — see
// the User Switcher. Market data itself (MarketObservation, HistoricalBar)
// stays global/shared: every user is looking at the same market, just
// comparing it against their own last-seen checkpoint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A demo identity, not an account — no credentials, no session. Selecting
/// one in the UI only changes which watchlist/checkpoints subsequent reads
/// and writes are scoped to.
model User {
  id             String          @id @default(cuid())
  name           String          @unique
  createdAt      DateTime        @default(now())
  watchlistItems WatchlistItem[]
  checkpoints    Checkpoint[]
}

/// A symbol a specific user has chosen to track. The same symbol can
/// appear on multiple users' watchlists independently.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  addedAt   DateTime @default(now())

  @@unique([userId, symbol])
  @@index([symbol])
}

/// Source of a market observation — where the number actually came from.
/// EXTERNAL is reserved for a future real market-data provider (not wired
/// up yet — see IMarketDataProvider); only SYNTHETIC is produced today.
enum ObservationSource {
  EXTERNAL
  SYNTHETIC
  STATIC_SNAPSHOT
}

/// How trustworthy/current an observation is. This is orthogonal to
/// `source`: a LIVE observation and a CACHED observation can both have
/// originally come from an EXTERNAL provider, but freshness tells the UI
/// (and the change engine) whether it's safe to treat the number as "right now".
enum Freshness {
  LIVE
  DELAYED
  /// Market is closed; this is legitimate last-close data, not an error
  /// state — distinct from STALE, which means data older than that.
  CLOSED
  STALE
  CACHED
  STATIC
  UNAVAILABLE
}

/// A single normalized market data point for a symbol. This is the
/// persisted cache that lets the Market Data Service fall back to
/// "latest known good" when the live provider fails, and it is also the
/// audit trail of everything the app has ever observed.
model MarketObservation {
  id         String            @id @default(cuid())
  symbol     String
  price      Float
  volume     BigInt?
  observedAt DateTime
  receivedAt DateTime          @default(now())
  source     ObservationSource
  freshness  Freshness

  @@index([symbol, observedAt(sort: Desc)])
  @@index([symbol, receivedAt(sort: Desc)])
}

/// One EOD bar used as historical baseline (last N completed trading days).
model HistoricalBar {
  id     String   @id @default(cuid())
  symbol String
  date   DateTime
  close  Float
  volume BigInt?

  @@unique([symbol, date])
  @@index([symbol, date(sort: Desc)])
}

/// "What this user last successfully saw" for a symbol. Updated only after
/// the dashboard has been rendered with valid, non-stale data and the
/// client has acknowledged it. One row per (user, symbol) — every user
/// maintains their own independent checkpoint against the same shared
/// MarketObservation history, so Alice viewing TCS.NS never moves Bob's
/// TCS.NS baseline.
model Checkpoint {
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  price       Float
  volume      BigInt?
  observedAt  DateTime
  source      ObservationSource
  freshness   Freshness
  checkedAt   DateTime          @default(now())

  @@id([userId, symbol])
}

/// Which market condition a symbol is currently pinned to for Market
/// Simulation — testing/exploration infrastructure (see demoService), not
/// a presenter-only mode. Independent of the globally configured market
/// data provider — activating a scenario always routes that symbol
/// through the synthetic provider so simulations work even when the app
/// is otherwise wired to Yahoo.
enum DemoScenario {
  NORMAL_MARKET
  PRICE_SHOCK
  VOLUME_SPIKE
  SECTOR_DIVERGENCE
  STALE_DATA
  PROVIDER_FAILURE
}

/// Persisted state for Market Simulation: which condition each symbol is
/// currently pinned to. Symbol-keyed and global — it simulates the shared
/// MarketObservation, so every user watching that symbol sees the same
/// underlying data (their classifications can still differ; see
/// Checkpoint).
model DemoScenarioState {
  symbol    String       @id
  scenario  DemoScenario @default(NORMAL_MARKET)
  updatedAt DateTime     @updatedAt
}
