# PostgreSQL connection string. When using `docker compose up`, the `app`
# service overrides this to point at the `db` container.
DATABASE_URL="postgresql://whatdidimiss:whatdidimiss@localhost:5432/whatdidimiss"

# "yahoo" | "synthetic"
# yahoo    — use Yahoo Finance as the primary source, with fallback to the
#            latest cached observation and then the bundled static snapshot.
# synthetic — use deterministic generated data for every symbol (recommended
#             for local demo, offline development, and CI, since it doesn't
#             depend on outbound network access or Yahoo's rate limits).
MARKET_DATA_PROVIDER="synthetic"

# Milliseconds to wait for the Yahoo Finance API before treating the call as
# a timeout failure and falling back.
MARKET_DATA_TIMEOUT_MS="5000"
