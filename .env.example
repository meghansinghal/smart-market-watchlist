# PostgreSQL connection string. When using `docker compose up`, the `app`
# service overrides this to point at the `db` container.
DATABASE_URL="postgresql://whatdidimiss:whatdidimiss@localhost:5432/whatdidimiss"

# Used only by `prisma migrate deploy`/`dev` (see prisma/schema.prisma).
# Locally, a plain Postgres has no pooling distinction, so this can be
# identical to DATABASE_URL. In production (e.g. Neon), this must be the
# *unpooled/direct* connection string, even though DATABASE_URL is pooled.
DIRECT_URL="postgresql://whatdidimiss:whatdidimiss@localhost:5432/whatdidimiss"
